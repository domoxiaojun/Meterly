# /etc/systemd/system/meterly-server.service —— 中心 systemd 单二进制方式(与 docker compose 二选一)
# 安装步骤见 README的 systemd 部署说明。数据在 /var/lib/meterly-server(StateDirectory),
# 归属地库在其下 geo/,在线备份在 backups/。配置与面板口令在 /etc/meterly(只读)。
[Unit]
Description=Meterly server(流量统计中心)
Documentation=https://github.com/domoxiaojun/Meterly
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meterly
Group=meterly
Environment=METERLY_CONFIG=/etc/meterly/server.json
ExecStart=/usr/local/bin/meterly-server serve
Restart=always
RestartSec=5
TimeoutStopSec=20

# 资源
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096

# 文件系统:只读系统,仅 StateDirectory 可写
UMask=0077
StateDirectory=meterly-server
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/meterly
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed

# 权限
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# 内核 / 进程
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# 网络:只需监听 + 出站下载 DB-IP;不限制出站地址
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
