# 可选:中心 systemd 方式的每日在线备份(SQLite VACUUM INTO,不停服务)。配合 meterly-backup.timer。
# 保留最近 14 份。docker compose 方式见 deploy/compose/README.md「备份」。
[Unit]
Description=Meterly server 在线备份
After=meterly-server.service

[Service]
Type=oneshot
User=meterly
Group=meterly
Environment=METERLY_CONFIG=/etc/meterly/server.json
UMask=0077
ExecStart=/bin/sh -c 'exec /usr/local/bin/meterly-server backup -out /var/lib/meterly-server/backups/ts-$(date +%%Y%%m%%d-%%H%%M%%S).db'
ExecStartPost=/bin/sh -c 'ls -1t /var/lib/meterly-server/backups/ts-*.db 2>/dev/null | tail -n +15 | xargs -r rm -f'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/meterly-server
ReadOnlyPaths=/etc/meterly
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=yes
