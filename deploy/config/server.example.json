{
  "listen": "127.0.0.1:8787",
  "db_path": "/var/lib/meterly-server/meterly.db",
  "panel_token_file": "/etc/meterly/panel.token",
  "tz": "Asia/Singapore",
  "reset_day": 9,
  "offline_after_minutes": 5,
  "retention": {
    "MinuteDays": 14,
    "HourDays": 400,
    "TopNHour": 50,
    "TopNDay": 200,
    "MinuteDetailHours": 25
  },
  "geo": {
    "dir": "/var/lib/meterly-server/geo",
    "auto_update": true
  },
  "trusted_proxies": []
}
